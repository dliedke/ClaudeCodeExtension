<UserControl x:Class="ClaudeCodeVS.UI.ChatTranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:ClaudeCodeVS.UI"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- Effort pill slider + themed dropdown chrome, shared with the panel -->
				<ResourceDictionary Source="/ClaudeCodeExtension;component/UI/ChatStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

		<!-- Chat font. Replaced at runtime by SetChatFont from the settings, which is why every
		     style below takes it as a DynamicResource instead of hard-coding a face. -->
		<FontFamily x:Key="ChatFontFamily">Segoe UI</FontFamily>
		<FontFamily x:Key="ChatCodeFontFamily">Cascadia Mono, Consolas</FontFamily>
		<sys:Double x:Key="ChatFontSize">12</sys:Double>
		<sys:Double x:Key="ChatSmallFontSize">11</sys:Double>
		<sys:Double x:Key="ChatTinyFontSize">10</sys:Double>

		<!-- Accents. Deliberately literal colours rather than theme brushes: these have to mean the
		     same thing ("this was added", "this ran a command") in both the dark and the light theme,
		     and the VS palette has no stable key for either. -->
		<SolidColorBrush x:Key="ChatAccentBrush" Color="#1C8AE0"/>

		<!-- Link/quote-border accent used by MarkdownBlock. Overwritten in code-behind based on the
		     active VS theme (a fixed blue reads fine on light backgrounds but too dark on near-black
		     ones) — DynamicResource so every row, including ones created after the swap, picks it up. -->
		<SolidColorBrush x:Key="ChatLinkAccentBrush" Color="#1C8AE0"/>
		<SolidColorBrush x:Key="DiffAddedForeground" Color="#2EA043"/>
		<SolidColorBrush x:Key="DiffRemovedForeground" Color="#D1242F"/>
		<SolidColorBrush x:Key="DiffAddedBackground" Color="#242EA043"/>
		<SolidColorBrush x:Key="DiffRemovedBackground" Color="#24D1242F"/>
		<SolidColorBrush x:Key="ChatErrorBrush" Color="#E51400"/>

		<!-- Text selection in the read-only transcript: a soft tint of the chat's own accent, not the
		     VS theme's HighlightKey — that one renders as a saturated violet block here and fights with
		     the accent-blue link text sitting on top of it. -->
		<SolidColorBrush x:Key="ChatSelectionBrush" Color="#661C8AE0"/>

		<local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
		<local:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>

		<!-- Read-only text that can still be selected and copied: a TextBlock cannot be,
		     and copying an answer is the single most common thing users do with a chat. -->
		<Style x:Key="SelectableTextStyle" TargetType="TextBox">
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="IsReadOnlyCaretVisible" Value="False"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="FontFamily" Value="{DynamicResource ChatFontFamily}"/>
			<Setter Property="FontSize" Value="{DynamicResource ChatFontSize}"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
			<Setter Property="SelectionBrush" Value="{StaticResource ChatSelectionBrush}"/>
			<Setter Property="SelectionOpacity" Value="1"/>
		</Style>

		<Style x:Key="CodeTextStyle" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
			<Setter Property="FontFamily" Value="{DynamicResource ChatCodeFontFamily}"/>
			<Setter Property="FontSize" Value="{DynamicResource ChatSmallFontSize}"/>
			<Setter Property="TextWrapping" Value="NoWrap"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
		</Style>

		<!-- Rendered markdown: headings, lists, tables, emphasis and fenced code. -->
		<Style x:Key="MarkdownBodyStyle" TargetType="local:MarkdownBlock">
			<Setter Property="FontFamily" Value="{DynamicResource ChatFontFamily}"/>
			<Setter Property="FontSize" Value="{DynamicResource ChatFontSize}"/>
			<Setter Property="CodeFontFamily" Value="{DynamicResource ChatCodeFontFamily}"/>
			<Setter Property="AccentBrush" Value="{DynamicResource ChatLinkAccentBrush}"/>
			<Setter Property="CodeBackground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
			<Setter Property="CodeBorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
			<Setter Property="SelectionBrush" Value="{StaticResource ChatSelectionBrush}"/>
			<Setter Property="SelectionOpacity" Value="1"/>
		</Style>

		<!-- Message body: raw text while streaming, rendered markdown once the turn ends. Splitting
		     markdown on every token delta would re-layout the list dozens of times a second. -->
		<DataTemplate x:Key="MessageBodyTemplate">
			<Grid>
				<TextBox Style="{StaticResource SelectableTextStyle}"
				         Text="{Binding Text, Mode=OneWay}"
				         Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
				<local:MarkdownBlock Style="{StaticResource MarkdownBodyStyle}"
				                     Markdown="{Binding RenderedText, Mode=OneWay}"
				                     Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVis}}"
				                     LinkClicked="MarkdownBlock_LinkClicked"/>
			</Grid>
		</DataTemplate>

		<!-- User prompt -->
		<DataTemplate x:Key="UserTemplate">
			<Border Margin="30,8,0,8" Padding="11,8,11,8" CornerRadius="7,7,2,7"
			        HorizontalAlignment="Right"
			        Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
			        BorderBrush="{StaticResource ChatAccentBrush}"
			        BorderThickness="1">
				<TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text, Mode=OneWay}"/>
			</Border>
		</DataTemplate>

		<!-- Agent answer -->
		<DataTemplate x:Key="AssistantTemplate">
			<ContentControl Margin="2,6,24,8" Content="{Binding}"
			                ContentTemplate="{StaticResource MessageBodyTemplate}"/>
		</DataTemplate>

		<!-- Collapsible row whose whole header is the click target, chevron included. The stock
		     Expander puts a tiny arrow on the left and leaves the rest of the row dead, which makes a
		     one-line tool card annoying to open. -->
		<Style x:Key="RowExpanderStyle" TargetType="Expander">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Expander">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<ToggleButton x:Name="Toggle" Grid.Row="0"
							              Focusable="False"
							              Cursor="Hand"
							              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border x:Name="HeaderShell" Background="Transparent" Padding="4,4,4,4">
											<DockPanel LastChildFill="True">
												<TextBlock x:Name="Chevron" DockPanel.Dock="Left"
												           Text="›" FontSize="13" Opacity="0.55"
												           Width="14" TextAlignment="Center"
												           VerticalAlignment="Center"
												           RenderTransformOrigin="0.5,0.5">
													<TextBlock.RenderTransform>
														<RotateTransform Angle="0"/>
													</TextBlock.RenderTransform>
												</TextBlock>
												<ContentPresenter ContentSource="Content"/>
											</DockPanel>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="HeaderShell" Property="Background"
												        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
											</Trigger>
											<Trigger Property="IsChecked" Value="True">
												<Setter TargetName="Chevron" Property="RenderTransform">
													<Setter.Value>
														<RotateTransform Angle="90"/>
													</Setter.Value>
												</Setter>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
								<ContentPresenter ContentSource="Header"/>
							</ToggleButton>
							<ContentPresenter x:Name="Body" Grid.Row="1" Visibility="Collapsed"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsExpanded" Value="True">
								<Setter TargetName="Body" Property="Visibility" Value="Visible"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Extended thinking, collapsed by default -->
		<DataTemplate x:Key="ThinkingTemplate">
			<Expander Margin="2,3,24,3" Style="{StaticResource RowExpanderStyle}"
			          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
			          Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
				<Expander.Header>
					<StackPanel Orientation="Horizontal" Opacity="0.7">
						<TextBlock Text="✷" FontSize="{DynamicResource ChatSmallFontSize}" Margin="2,0,6,0"
						           VerticalAlignment="Center"/>
						<TextBlock Text="{Binding Header}" FontStyle="Italic"
						           FontSize="{DynamicResource ChatSmallFontSize}"
						           VerticalAlignment="Center"/>
					</StackPanel>
				</Expander.Header>
				<Border Margin="18,2,0,6" Padding="9,7,9,7" CornerRadius="4"
				        Opacity="0.8"
				        Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
					<local:MarkdownBlock Style="{StaticResource MarkdownBodyStyle}"
					                     FontStyle="Italic"
					                     Markdown="{Binding RenderedText, Mode=OneWay}"
					                     LinkClicked="MarkdownBlock_LinkClicked"/>
				</Border>
			</Expander>
		</DataTemplate>

		<!-- One line of a rendered diff -->
		<DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type local:ChatDiffLine}">
			<Border x:Name="Row" Padding="8,0,10,0">
				<StackPanel Orientation="Horizontal">
					<TextBlock x:Name="Marker" Text="{Binding Marker}"
					           FontFamily="{DynamicResource ChatCodeFontFamily}"
					           FontSize="{DynamicResource ChatSmallFontSize}"
					           Width="12" Opacity="0.9"/>
					<TextBlock x:Name="Body" Text="{Binding Text}"
					           FontFamily="{DynamicResource ChatCodeFontFamily}"
					           FontSize="{DynamicResource ChatSmallFontSize}"
					           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
				</StackPanel>
			</Border>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsAdded}" Value="True">
					<Setter TargetName="Row" Property="Background" Value="{StaticResource DiffAddedBackground}"/>
					<Setter TargetName="Marker" Property="Foreground" Value="{StaticResource DiffAddedForeground}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsRemoved}" Value="True">
					<Setter TargetName="Row" Property="Background" Value="{StaticResource DiffRemovedBackground}"/>
					<Setter TargetName="Marker" Property="Foreground" Value="{StaticResource DiffRemovedForeground}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsSeparator}" Value="True">
					<Setter TargetName="Body" Property="Opacity" Value="0.5"/>
					<Setter TargetName="Body" Property="FontStyle" Value="Italic"/>
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!-- Tool call. Collapsed it is one informative line — the tool, what it touched and how much
		     changed — because a column of bare "Read"/"Edit" labels says nothing about the turn. -->
		<DataTemplate x:Key="ToolTemplate">
			<Border Margin="2,3,24,3" CornerRadius="4" ClipToBounds="True"
			        Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
			        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
			        BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="3"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Rectangle Grid.Column="0" Fill="{Binding ToolAccent}"/>

					<Expander Grid.Column="1" Style="{StaticResource RowExpanderStyle}"
					          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
					          Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
						<Expander.Header>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<TextBlock Grid.Column="0" Text="{Binding ToolIcon}"
								           Foreground="{Binding ToolAccent}"
								           FontSize="{DynamicResource ChatFontSize}"
								           Margin="2,0,7,0" VerticalAlignment="Center"/>

								<TextBlock Grid.Column="1" Text="{Binding Header}"
								           FontSize="{DynamicResource ChatSmallFontSize}"
								           FontWeight="SemiBold"
								           VerticalAlignment="Center"/>

								<TextBlock Grid.Column="2" Text="{Binding ToolTarget}"
								           FontFamily="{DynamicResource ChatCodeFontFamily}"
								           FontSize="{DynamicResource ChatSmallFontSize}"
								           Opacity="0.72"
								           Margin="9,0,9,0"
								           VerticalAlignment="Center"
								           TextTrimming="CharacterEllipsis"
								           ToolTip="{Binding ToolTarget}"/>

								<!-- Still running: the card is already in the transcript, so without this it
								     looks like a tool that finished and returned nothing. Animated (not a
								     static glyph) so a long-running tool, most visibly a subagent Task, reads
								     as busy rather than stuck. -->
								<TextBlock Grid.Column="3" Text="{Binding SpinnerGlyph}" Margin="0,0,6,0"
								           FontSize="{DynamicResource ChatFontSize}"
								           VerticalAlignment="Center" Opacity="0.6"
								           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

								<Border Grid.Column="4" CornerRadius="3" Padding="5,1,5,1"
								        VerticalAlignment="Center"
								        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
								        Visibility="{Binding ToolBadge, Converter={StaticResource EmptyToVis}}">
									<TextBlock Text="{Binding ToolBadge}"
									           FontFamily="{DynamicResource ChatCodeFontFamily}"
									           FontSize="{DynamicResource ChatTinyFontSize}"
									           Foreground="{Binding ToolAccent}"/>
								</Border>

								<TextBlock Grid.Column="5" Text="✕" Margin="6,0,0,0"
								           FontSize="{DynamicResource ChatSmallFontSize}"
								           VerticalAlignment="Center"
								           Foreground="{StaticResource ChatErrorBrush}"
								           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
							</Grid>
						</Expander.Header>

						<StackPanel Margin="22,0,8,8">
							<!-- Diff for the editing tools: what actually changed, in the shape the CLI
							     shows it, instead of the same strings twice as JSON. -->
							<Border Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}"
							        CornerRadius="3" Margin="0,2,0,2"
							        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
							        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
							        BorderThickness="1">
								<ScrollViewer MaxHeight="340"
								              VerticalScrollBarVisibility="Auto"
								              HorizontalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding Diff}"
									              ItemTemplate="{StaticResource DiffLineTemplate}"
									              Margin="0,4,0,4"/>
								</ScrollViewer>
							</Border>

							<TextBox Style="{StaticResource CodeTextStyle}"
							         Text="{Binding ToolInputJson, Mode=OneWay}"
							         Visibility="{Binding ShowRawInput, Converter={StaticResource BoolToVis}}"/>

							<Separator Margin="0,6,0,6" Opacity="0.3"
							           Visibility="{Binding ToolResult, Converter={StaticResource EmptyToVis}}"/>
							<TextBox Style="{StaticResource CodeTextStyle}"
							         Text="{Binding ToolResult, Mode=OneWay}"
							         Visibility="{Binding ToolResult, Converter={StaticResource EmptyToVis}}"/>
						</StackPanel>
					</Expander>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- Session failure -->
		<DataTemplate x:Key="ErrorTemplate">
			<Border Margin="2,6,24,6" Padding="10,8,10,8" CornerRadius="4"
			        Background="#22E51400" BorderBrush="#88E51400" BorderThickness="1">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="✕" Margin="0,0,8,0" FontWeight="Bold"
					           Foreground="{StaticResource ChatErrorBrush}"/>
					<TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text, Mode=OneWay}"/>
				</StackPanel>
			</Border>
		</DataTemplate>

		<!-- Neutral status line -->
		<DataTemplate x:Key="NoticeTemplate">
			<Border Margin="2,5,24,5" Padding="9,5,9,5" CornerRadius="4"
			        HorizontalAlignment="Left"
			        Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
				<TextBlock Text="{Binding Text}" TextWrapping="Wrap"
				           FontSize="{DynamicResource ChatSmallFontSize}" Opacity="0.75"/>
			</Border>
		</DataTemplate>

		<!-- One answer button. The selected state has to be obvious at a glance, so it takes the
		     accent border and a tinted fill rather than only a check mark. -->
		<Style x:Key="InteractionOptionStyle" TargetType="Button">
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
			<Setter Property="Padding" Value="9,6,9,6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Shell" CornerRadius="4"
						        Background="Transparent"
						        BorderThickness="1"
						        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
							<ContentPresenter Margin="{TemplateBinding Padding}"
							                  HorizontalAlignment="Stretch"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Shell" Property="Background"
								        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
							</Trigger>
							<DataTrigger Binding="{Binding IsSelected}" Value="True">
								<Setter TargetName="Shell" Property="BorderBrush" Value="#1C8AE0"/>
								<Setter TargetName="Shell" Property="Background" Value="#221C8AE0"/>
							</DataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Action buttons at the bottom of an interaction card -->
		<Style x:Key="InteractionPrimaryStyle" TargetType="Button">
			<Setter Property="Background" Value="#1C8AE0"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="{DynamicResource ChatSmallFontSize}"/>
			<Setter Property="Padding" Value="14,4,14,4"/>
			<Setter Property="Margin" Value="6,0,0,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Shell" CornerRadius="3"
						        Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Shell" Property="Opacity" Value="0.85"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Shell" Property="Opacity" Value="0.4"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="InteractionSecondaryStyle" TargetType="Button" BasedOn="{StaticResource InteractionPrimaryStyle}">
			<Setter Property="Background" Value="#33808080"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>

		<!-- One question inside a question card -->
		<DataTemplate x:Key="InteractionQuestionTemplate" DataType="{x:Type local:ChatQuestionViewModel}">
			<StackPanel Margin="0,0,0,10">
				<Border Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}"
				        HorizontalAlignment="Left"
				        Margin="0,0,0,4" Padding="6,1,6,1" CornerRadius="3"
				        Background="#331C8AE0">
					<TextBlock Text="{Binding Header}" FontSize="{DynamicResource ChatTinyFontSize}" FontWeight="SemiBold"
					           Opacity="0.9"
					           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
				</Border>

				<TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,0,0,6"
				           FontWeight="SemiBold"/>

				<ItemsControl ItemsSource="{Binding Options}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="{x:Type local:ChatOptionViewModel}">
							<!-- Tag carries the owning question: the click handler needs it to clear the
							     other options of a single-select question. -->
							<Button Style="{StaticResource InteractionOptionStyle}"
							        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
							        Click="InteractionOption_Click">
								<StackPanel>
									<TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
									<TextBlock Text="{Binding Description}" TextWrapping="Wrap"
									           FontSize="{DynamicResource ChatTinyFontSize}" Opacity="0.65" Margin="0,2,0,0"
									           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"/>
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Grid Margin="0,2,0,0">
					<TextBox Text="{Binding OtherAnswer, UpdateSourceTrigger=PropertyChanged}"
					         Padding="6,4,6,4"
					         TextWrapping="Wrap" AcceptsReturn="True"
					         Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
					         Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
					         CaretBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
					         SelectionBrush="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
					         BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
					         BorderThickness="1"/>
					<TextBlock Text="Other — type your own answer…"
					           IsHitTestVisible="False"
					           Margin="8,5,0,0" Opacity="0.5" FontSize="{DynamicResource ChatSmallFontSize}"
					           VerticalAlignment="Top"
					           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
					           Visibility="{Binding OtherAnswer, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}"/>
				</Grid>
			</StackPanel>
		</DataTemplate>

		<!-- Question / plan / tool-permission card. Stays in the transcript once answered, showing
		     what was decided, so scrolling back still explains why the agent did what it did. -->
		<DataTemplate x:Key="InteractionTemplate" DataType="{x:Type local:ChatInteractionViewModel}">
			<Border Margin="2,8,24,8" Padding="12,10,12,10" CornerRadius="5"
			        Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
			        BorderBrush="#881C8AE0" BorderThickness="1">
				<StackPanel>
					<TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,8"
					           TextWrapping="Wrap"/>

					<!-- Pending: the actual controls -->
					<StackPanel Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
						<ItemsControl ItemsSource="{Binding Questions}"
						              ItemTemplate="{StaticResource InteractionQuestionTemplate}"
						              Visibility="{Binding IsQuestion, Converter={StaticResource BoolToVis}}"/>

						<Border Visibility="{Binding IsPlanReview, Converter={StaticResource BoolToVis}}"
						        Padding="8,6,8,6" CornerRadius="3" Margin="0,0,0,4"
						        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
							<ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
								<local:MarkdownBlock Style="{StaticResource MarkdownBodyStyle}"
								                     Markdown="{Binding PlanText, Mode=OneWay}"
								                     LinkClicked="MarkdownBlock_LinkClicked"/>
							</ScrollViewer>
						</Border>

						<StackPanel Visibility="{Binding IsToolApproval, Converter={StaticResource BoolToVis}}">
							<TextBox Style="{StaticResource CodeTextStyle}"
							         Text="{Binding ToolInputJson, Mode=OneWay}"
							         Visibility="{Binding ToolInputJson, Converter={StaticResource EmptyToVis}}"/>
						</StackPanel>

						<DockPanel Margin="0,8,0,0" LastChildFill="False">
							<!-- Caret next to Allow: keeps "Allow for the rest of this session" out of the
							     button row (issue #149) instead of adding a third button. Tool-approval only. -->
							<Button DockPanel.Dock="Right"
							        Style="{StaticResource InteractionPrimaryStyle}"
							        Padding="7,4,7,4"
							        Content="▾"
							        ToolTip="More allow options"
							        Visibility="{Binding CanAllowForSession, Converter={StaticResource BoolToVis}}"
							        Click="InteractionAllowMenu_Click">
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem Header="{Binding AllowForSessionCaption}"
										          Click="InteractionAllowForSession_Click"/>
									</ContextMenu>
								</Button.ContextMenu>
							</Button>
							<Button DockPanel.Dock="Right"
							        Style="{StaticResource InteractionPrimaryStyle}"
							        Content="{Binding SubmitCaption}"
							        Click="InteractionSubmit_Click"/>
							<Button DockPanel.Dock="Right"
							        Style="{StaticResource InteractionSecondaryStyle}"
							        Content="{Binding RejectCaption}"
							        Click="InteractionReject_Click"/>
						</DockPanel>
					</StackPanel>

					<!-- Answered: one line saying what happened -->
					<TextBlock Text="{Binding Outcome}" TextWrapping="Wrap"
					           FontSize="{DynamicResource ChatSmallFontSize}" Opacity="0.75" FontStyle="Italic"
					           Visibility="{Binding IsResolved, Converter={StaticResource BoolToVis}}"/>
				</StackPanel>
			</Border>
		</DataTemplate>

		<!-- Composer selector ("Sonnet ▾", "Ask ▾"): flat until hovered, so four of them in a
		     row read as one strip instead of four competing buttons. -->
		<Style x:Key="ComposerSelectorStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="7,2,7,2"/>
			<Setter Property="Margin" Value="0,0,2,0"/>
			<Setter Property="FontSize" Value="{DynamicResource ChatSmallFontSize}"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
								<Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedBorderKey}}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Accent style for the send button, so the primary action reads as primary -->
		<Style x:Key="ComposerSendStyle" TargetType="Button" BasedOn="{StaticResource ComposerSelectorStyle}">
			<Setter Property="Background" Value="#1C8AE0"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="12,2,12,2"/>
			<Setter Property="Margin" Value="6,0,0,0"/>
		</Style>

		</ResourceDictionary>
	</UserControl.Resources>

	<!-- LayoutTransform (not RenderTransform) so Ctrl+Scroll zoom re-flows the text at the new
	     scale instead of blurring a bitmap, and the scroll bars keep matching the content. -->
	<Grid x:Name="RootGrid" PreviewMouseWheel="Root_PreviewMouseWheel"
	      TextElement.FontFamily="{DynamicResource ChatFontFamily}"
	      TextElement.FontSize="{DynamicResource ChatFontSize}">
		<Grid.LayoutTransform>
			<ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
		</Grid.LayoutTransform>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<DockPanel Grid.Row="0" LastChildFill="True">
			<!-- Custom session name (✎ button / Session History rename), shown here instead of the tab
			     caption — the VS document tab is narrow and truncates long titles awkwardly. Collapsed
			     when the session has no custom title. -->
			<Border x:Name="SessionTitleBar" DockPanel.Dock="Top"
			        Visibility="Collapsed"
			        Padding="10,5,10,5"
			        Cursor="Hand"
			        ToolTip="Click to rename this session"
			        MouseLeftButtonUp="SessionTitleBar_MouseLeftButtonUp"
			        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
			        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
			        BorderThickness="0,0,0,1">
				<DockPanel LastChildFill="True">
					<!-- Own click handler (marks the event handled) so picking a color doesn't also
					     trigger the rename dialog bound to the rest of the bar. -->
					<Border x:Name="SessionColorSwatch" DockPanel.Dock="Right"
					        Width="12" Height="12" CornerRadius="6"
					        Margin="8,0,0,0"
					        Cursor="Hand"
					        ToolTip="Change session color"
					        MouseLeftButtonUp="SessionColorSwatch_MouseLeftButtonUp"
					        Background="{StaticResource ChatAccentBrush}"
					        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
					        BorderThickness="1"/>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="✎" FontSize="{DynamicResource ChatSmallFontSize}" Opacity="0.6"
						           Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock x:Name="SessionTitleText"
						           FontSize="{DynamicResource ChatSmallFontSize}"
						           FontWeight="SemiBold"
						           VerticalAlignment="Center"
						           TextTrimming="CharacterEllipsis"
						           Foreground="{StaticResource ChatAccentBrush}"/>
					</StackPanel>
				</DockPanel>
			</Border>

			<ScrollViewer x:Name="TranscriptScroll"
			              VerticalScrollBarVisibility="Auto"
			              HorizontalScrollBarVisibility="Disabled"
			              Padding="8,4,8,4"
			              ScrollChanged="TranscriptScroll_ScrollChanged">
			<!-- Above the rows rather than layered over them: the card is part of the conversation's
			     content, so it scrolls with it and can never cover the first answer. -->
			<StackPanel>
				<!-- Empty state of a fresh conversation: what is running, where, and what the chat can
				     do. Filled by ShowWelcome and dropped as soon as the user sends the first prompt. -->
				<Grid x:Name="WelcomeBanner" Visibility="Collapsed" Margin="2,6,2,12">
					<Border BorderBrush="{StaticResource ChatAccentBrush}"
					        BorderThickness="1" CornerRadius="4"
					        Margin="0,8,0,0" Padding="14,14,14,12">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0" MinWidth="150" Margin="6,0,14,0">
								<TextBlock Text="Welcome back!"
								           HorizontalAlignment="Center"
								           FontWeight="SemiBold"
								           FontSize="{DynamicResource ChatFontSize}"/>

								<!-- Drawn rather than typed: an emoji or a glyph mascot depends on a
								     font being installed, and a missing one renders as an empty box. -->
								<Viewbox Width="84" Height="60" Margin="0,10,0,10">
									<Canvas Width="14" Height="10">
										<Rectangle Canvas.Left="2" Canvas.Top="0" Width="10" Height="1"
										           Fill="{StaticResource ChatAccentBrush}"/>
										<Rectangle Canvas.Left="1" Canvas.Top="1" Width="12" Height="5"
										           Fill="{StaticResource ChatAccentBrush}"/>
										<Rectangle Canvas.Left="1.6" Canvas.Top="6" Width="1.6" Height="2.6"
										           Fill="{StaticResource ChatAccentBrush}"/>
										<Rectangle Canvas.Left="4.6" Canvas.Top="6" Width="1.6" Height="2.6"
										           Fill="{StaticResource ChatAccentBrush}"/>
										<Rectangle Canvas.Left="7.8" Canvas.Top="6" Width="1.6" Height="2.6"
										           Fill="{StaticResource ChatAccentBrush}"/>
										<Rectangle Canvas.Left="10.8" Canvas.Top="6" Width="1.6" Height="2.6"
										           Fill="{StaticResource ChatAccentBrush}"/>
										<!-- Eyes are punched out in the panel colour, so the critter reads
										     the same way under both themes. -->
										<Rectangle Canvas.Left="3.6" Canvas.Top="2" Width="1.6" Height="1.8"
										           Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
										<Rectangle Canvas.Left="8.8" Canvas.Top="2" Width="1.6" Height="1.8"
										           Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
									</Canvas>
								</Viewbox>

								<ItemsControl x:Name="WelcomeFacts">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding}"
											           HorizontalAlignment="Center"
											           TextAlignment="Center"
											           TextWrapping="Wrap"
											           Margin="0,0,0,2"
											           Opacity="0.75"
											           FontSize="{DynamicResource ChatSmallFontSize}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>

							<Rectangle Grid.Column="1" Width="1" Margin="0,2,14,2" Opacity="0.35"
							           Fill="{StaticResource ChatAccentBrush}"/>

							<StackPanel Grid.Column="2" VerticalAlignment="Center">
								<TextBlock Text="Tips for getting started"
								           FontWeight="SemiBold"
								           Margin="0,0,0,4"
								           FontSize="{DynamicResource ChatFontSize}"
								           Foreground="{StaticResource ChatAccentBrush}"/>
								<ItemsControl x:Name="WelcomeTips">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding}"
											           TextWrapping="Wrap"
											           Margin="0,0,0,3"
											           Opacity="0.85"
											           FontSize="{DynamicResource ChatSmallFontSize}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Grid>
					</Border>

					<!-- Caption sitting on the frame, the way the CLI's banner draws it. Its own
					     background is what breaks the border line behind the text. -->
					<Border HorizontalAlignment="Left" VerticalAlignment="Top"
					        Margin="12,0,0,0" Padding="5,0,5,0"
					        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
						<TextBlock x:Name="WelcomeTitle"
						           FontWeight="SemiBold"
						           FontSize="{DynamicResource ChatFontSize}"
						           Foreground="{StaticResource ChatAccentBrush}"/>
					</Border>
				</Grid>

				<ItemsControl x:Name="MessagesList">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<VirtualizingStackPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplateSelector>
						<local:ChatMessageTemplateSelector
							UserTemplate="{StaticResource UserTemplate}"
							AssistantTemplate="{StaticResource AssistantTemplate}"
							ThinkingTemplate="{StaticResource ThinkingTemplate}"
							ToolTemplate="{StaticResource ToolTemplate}"
							ErrorTemplate="{StaticResource ErrorTemplate}"
							NoticeTemplate="{StaticResource NoticeTemplate}"
							InteractionTemplate="{StaticResource InteractionTemplate}"/>
					</ItemsControl.ItemTemplateSelector>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
		</DockPanel>

		<!-- Appears only while the user has scrolled away from the newest message -->
		<Button x:Name="ScrollToEndButton" Grid.Row="0"
		        Content="↓"
		        Width="26" Height="26"
		        Margin="0,0,20,12"
		        HorizontalAlignment="Right" VerticalAlignment="Bottom"
		        Visibility="Collapsed"
		        ToolTip="Jump to the latest message"
		        Click="ScrollToEndButton_Click"/>

		<Border x:Name="StatusBar" Grid.Row="1"
		        Padding="8,3,8,3"
		        Visibility="Collapsed"
		        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
		        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
		        BorderThickness="0,1,0,0">
			<DockPanel LastChildFill="True">
				<!-- The only way to abort a turn in native mode: there is no console to press ESC in. -->
				<Button x:Name="StopButton" DockPanel.Dock="Right"
				        Content="■ Stop"
				        Padding="8,1,8,1"
				        FontSize="{DynamicResource ChatSmallFontSize}"
				        Margin="8,0,0,0"
				        Visibility="Collapsed"
				        ToolTip="Stop the turn in progress (Esc)"
				        Click="StopButton_Click"/>
				<!-- Its own element so the spinner can carry the accent colour while the text stays
				     muted; a single TextBlock would need inline runs rebuilt on every frame. -->
				<TextBlock x:Name="StatusSpinner" DockPanel.Dock="Left"
				           FontSize="{DynamicResource ChatFontSize}"
				           Margin="0,0,7,0"
				           Visibility="Collapsed"
				           VerticalAlignment="Center"
				           Foreground="{StaticResource ChatAccentBrush}"/>
				<TextBlock x:Name="StatusText" FontSize="{DynamicResource ChatSmallFontSize}" Opacity="0.75"
				           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
			</DockPanel>
		</Border>

		<!-- Composer: the chat can be driven entirely from here, so the tab is usable on its own
		     without going back to the panel's prompt box. Hidden while the chat sits in the panel,
		     where that prompt box is right above it. -->
		<Border x:Name="ComposerBar" Grid.Row="2"
		        Visibility="Collapsed"
		        Padding="8,6,8,8"
		        AllowDrop="True"
		        Drop="Composer_Drop"
		        PreviewDragOver="Composer_PreviewDragOver"
		        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
		        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
		        BorderThickness="0,1,0,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Drag the top edge of the composer to make the input taller or shorter -->
				<Thumb x:Name="ComposerResizeGrip" Grid.Row="0"
				       Height="6" Margin="0,-4,0,2"
				       Cursor="SizeNS"
				       ToolTip="Drag to resize the prompt area"
				       DragDelta="ComposerResizeGrip_DragDelta">
					<Thumb.Template>
						<ControlTemplate TargetType="Thumb">
							<Border Background="Transparent">
								<Rectangle Height="3" Width="34" RadiusX="1.5" RadiusY="1.5"
								           Opacity="0.35"
								           Fill="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
							</Border>
						</ControlTemplate>
					</Thumb.Template>
				</Thumb>

				<!-- Attachment chips, filled by the parent control from its own attachment list -->
				<WrapPanel x:Name="ComposerAttachments" Grid.Row="1" Margin="0,0,0,4"/>

				<Border Grid.Row="2" CornerRadius="4" Padding="6,4,6,4"
				        Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
				        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
				        BorderThickness="1">
					<Grid>
						<!-- CaretBrush is explicit: the default caret is black, which is invisible
						     against the dark-theme editor background and reads as "no cursor". -->
						<TextBox x:Name="ComposerInput"
						         Height="72" MinHeight="46"
						         AcceptsReturn="True"
						         TextWrapping="Wrap"
						         VerticalScrollBarVisibility="Auto"
						         BorderThickness="0"
						         Background="Transparent"
						         FontFamily="{DynamicResource ChatFontFamily}"
						         FontSize="{DynamicResource ChatFontSize}"
						         CaretBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
						         SelectionBrush="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
						         Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
						         PreviewKeyDown="ComposerInput_PreviewKeyDown"
						         TextChanged="ComposerInput_TextChanged"/>
						<TextBlock x:Name="ComposerPlaceholder"
						           Text="Ask anything · Ctrl+Up/Down for prompt history · Esc to stop"
						           IsHitTestVisible="False"
						           Margin="2,1,0,0"
						           Opacity="0.5"
						           FontSize="{DynamicResource ChatFontSize}"
						           VerticalAlignment="Top"
						           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
					</Grid>
				</Border>

				<DockPanel Grid.Row="3" Margin="0,6,0,0" LastChildFill="False">
					<Button x:Name="ComposerClearButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="↻"
					        FontSize="13"
					        ToolTip="Clear this conversation and start fresh"
					        Click="ComposerClearButton_Click"/>

					<Button x:Name="ComposerNewChatButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="✚"
					        FontSize="13"
					        ToolTip="Open new chat session in parallel tab"
					        Click="ComposerNewChatButton_Click"/>

					<Button x:Name="ComposerRenameSessionButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="✎"
					        FontSize="13"
					        ToolTip="Rename this session"
					        Click="ComposerRenameSessionButton_Click"/>

					<!-- Independent from rename — the header's own swatch only exists once a session has a
					     title, so this is the entry point that works even for a not-yet-renamed session. -->
					<Button x:Name="ComposerColorButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="🎨"
					        FontSize="13"
					        ToolTip="Change this session's color"
					        Click="ComposerColorButton_Click"/>

					<Button x:Name="ComposerAttachButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="📎"
					        ToolTip="Attach a file to the next prompt (Ctrl+V pastes an image)"
					        Click="ComposerAttachButton_Click"/>

					<Rectangle DockPanel.Dock="Left" Width="1" Margin="4,4,6,4" Opacity="0.25"
					           Fill="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>

					<Button x:Name="ComposerProviderButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="Agent ▾"
					        ToolTip="Change the AI agent"
					        Click="ComposerProviderButton_Click"/>

					<Button x:Name="ComposerModelButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="Model ▾"
					        ToolTip="Change the model"
					        Click="ComposerModelButton_Click"/>

					<Button x:Name="ComposerEffortButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="Effort ▾"
					        ToolTip="Change the effort level"
					        Click="ComposerEffortButton_Click"/>

					<Button x:Name="ComposerPermissionButton" DockPanel.Dock="Left"
					        Style="{StaticResource ComposerSelectorStyle}"
					        Content="Permissions ▾"
					        ToolTip="Change how tool permissions are handled"
					        Click="ComposerPermissionButton_Click"/>

					<Button x:Name="ComposerSendButton" DockPanel.Dock="Right"
					        Style="{StaticResource ComposerSendStyle}"
					        Content="➤  Send"
					        ToolTip="Send the prompt"
					        Click="ComposerSendButton_Click"/>
				</DockPanel>
			</Grid>
		</Border>

		<!-- Effort is a pill slider rather than a list, to match the model menu in the panel -->
		<Popup x:Name="EffortPopup" Grid.Row="2"
		       Placement="Top"
		       PlacementTarget="{Binding ElementName=ComposerEffortButton}"
		       StaysOpen="False"
		       AllowsTransparency="True"
		       PopupAnimation="Fade"
		       Opened="EffortPopup_Opened"
		       Closed="EffortPopup_Closed">
			<Border Padding="12,9,12,10" CornerRadius="5" Margin="6"
			        Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBackgroundGradientKey}}"
			        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBorderKey}}"
			        BorderThickness="1">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock x:Name="EffortPopupLabel" Text="Effort" Margin="1,0,0,6"
					           FontSize="{DynamicResource ChatSmallFontSize}"
					           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
					<Slider x:Name="EffortPopupSlider"
					        Style="{StaticResource EffortSliderStyle}"
					        ValueChanged="EffortPopupSlider_ValueChanged"/>
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>
