<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">

	<!-- ============ Composer dropdowns ============ -->
	<!-- The stock WPF ContextMenu draws a white chrome border and a permanent icon/checkbox gutter,
	     which looks wrong under a dark VS theme and wastes ~28px on every row. These templates drop
	     both and mark the current entry with a leading dot instead. -->

	<Style x:Key="ComposerMenuItemStyle" TargetType="MenuItem">
		<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Height" Value="26"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="MenuItem">
					<Border x:Name="Shell" Background="{TemplateBinding Background}"
					        CornerRadius="3" Margin="3,0,3,0" SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<!-- Shortcut ("Ctrl+C") for the menus that list one; empty and zero-wide otherwise. -->
							<TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
							           Margin="0,0,12,0" Opacity="0.6" VerticalAlignment="Center"/>
							<!-- Selection marker: a dot, not a checkbox square -->
							<Ellipse x:Name="Marker" Grid.Column="0" Width="5" Height="5"
							         Visibility="Collapsed"
							         HorizontalAlignment="Center" VerticalAlignment="Center"
							         Fill="{TemplateBinding Foreground}"/>
							<ContentPresenter Grid.Column="1" ContentSource="Header"
							                  RecognizesAccessKey="True"
							                  Margin="0,0,14,0"
							                  VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
						</Trigger>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Shell" Property="Background"
							        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
							<Setter Property="Foreground"
							        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground"
							        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextInactiveKey}}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Submenu row ("claude-opus ›"), used when a model list is too long for one flat dropdown.
	     ComposerMenuItemStyle cannot serve here: its template has no Popup, so its children would
	     never be shown. Same chrome as a normal row, plus the arrow and the child popup. -->
	<ControlTemplate x:Key="ComposerSubmenuTemplate" TargetType="MenuItem">
					<Border x:Name="Shell" Background="{TemplateBinding Background}"
					        CornerRadius="3" Margin="3,0,3,0" SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<ContentPresenter Grid.Column="1" ContentSource="Header"
							                  RecognizesAccessKey="True"
							                  Margin="0,0,8,0"
							                  VerticalAlignment="Center"/>
							<TextBlock Grid.Column="2" Text="&#x203A;" Margin="0,0,10,0"
							           VerticalAlignment="Center" Opacity="0.7"
							           Foreground="{TemplateBinding Foreground}"/>
							<Popup Grid.Column="2" Placement="Right" HorizontalOffset="-2"
							       IsOpen="{TemplateBinding IsSubmenuOpen}"
							       AllowsTransparency="True" Focusable="False">
								<Grid Margin="6">
									<Border CornerRadius="5" Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"><Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.2"/></Border.Effect></Border>
								<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
								        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBorderKey}}"
								        BorderThickness="1" CornerRadius="5" Padding="0,4,0,4"
								        SnapsToDevicePixels="True">
									<!-- The families are uneven: cursor-agent's largest holds 56 models -->
									<ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
										<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
									</ScrollViewer>
								</Border>
								</Grid>
							</Popup>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Shell" Property="Background"
							        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
						</Trigger>
						<Trigger Property="IsSubmenuOpen" Value="True">
							<Setter TargetName="Shell" Property="Background"
							        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground"
							        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextInactiveKey}}"/>
						</Trigger>
					</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="ComposerSubmenuStyle" TargetType="MenuItem">
		<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Height" Value="26"/>
		<Setter Property="Template" Value="{StaticResource ComposerSubmenuTemplate}"/>
	</Style>

	<Style x:Key="ComposerMenuSeparatorStyle" TargetType="Separator">
		<Setter Property="Margin" Value="8,4,8,4"/>
		<Setter Property="Height" Value="1"/>
		<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuSeparatorKey}}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Separator">
					<Rectangle Height="1" Fill="{TemplateBinding Background}" Opacity="0.6"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ComposerMenuStyle" TargetType="ContextMenu">
		<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
		<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarMenuBorderKey}}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="HasDropShadow" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ContextMenu">
					<!-- Margin for the shadow, which sits on its own layer so the rows keep ClearType. -->
					<Grid Margin="6">
						<Border CornerRadius="5" Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"><Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.2"/></Border.Effect></Border>
					<Border Background="{TemplateBinding Background}"
					        BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}"
					        CornerRadius="5"
					        Padding="0,4,0,4"
					        SnapsToDevicePixels="True">
						<!-- Scrolls rather than growing past the screen: a model list can be long even
						     after grouping, and this template replaces the stock one that scrolled. -->
						<ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
							<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
						</ScrollViewer>
					</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Every other menu of the extension (v280.0): the panel toolbar's 📎 ☰ ⚡ 🤖 ⚙, the prompt box's
	     Cut/Copy/Paste, the chat cards' ▾ menus and the chat text's Copy — same look as the composer
	     dropdowns. Their entries are declared in XAML or built in code without a style of their own, so
	     the styles are implicit here: a plain row, a submenu row when the entry has children, a thin
	     separator. A row whose header is taller than a line (the 🤖 menu's effort slider) sets its own
	     Height="Auto". -->
	<Style x:Key="ModernMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource ComposerMenuItemStyle}">
		<Style.Triggers>
			<Trigger Property="Role" Value="SubmenuHeader">
				<Setter Property="Template" Value="{StaticResource ComposerSubmenuTemplate}"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource ComposerMenuStyle}">
		<Style.Resources>
			<Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItemStyle}"/>
			<Style TargetType="Separator" BasedOn="{StaticResource ComposerMenuSeparatorStyle}"/>
			<Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
			       BasedOn="{StaticResource ComposerMenuSeparatorStyle}"/>
		</Style.Resources>
	</Style>

	<!-- Header row inside a dropdown ("Windows", "WSL"): not selectable, just groups the entries. -->
	<Style x:Key="ComposerMenuHeaderStyle" TargetType="MenuItem" BasedOn="{StaticResource ComposerMenuItemStyle}">
		<Setter Property="IsEnabled" Value="False"/>
		<Setter Property="Height" Value="22"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="Opacity" Value="0.8"/>
	</Style>

	<!-- ============ Effort pill slider (VS Code-like) ============ -->
	<!-- Filled (left of thumb) portion: blue, turns purple at the Max stop -->
	<Style x:Key="EffortFillButtonStyle" TargetType="RepeatButton">
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Background" Value="#1C8AE0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Background="{TemplateBinding Background}" CornerRadius="9"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<!-- Top stop turns purple, like the VS Code "ultracode" cap. EffortSliderStops flags it in the
			     slider's Tag, whatever the number of stops (it used to be a fixed Value="5"). -->
			<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="Top">
				<Setter Property="Background" Value="#9B7BD4"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- Unfilled (right of thumb) portion: transparent so the gray track shows through -->
	<Style x:Key="EffortTransparentButtonStyle" TargetType="RepeatButton">
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Background="Transparent"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- White circular thumb -->
	<Style x:Key="EffortThumbStyle" TargetType="Thumb">
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Width" Value="16"/>
		<Setter Property="Height" Value="16"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Ellipse Fill="#F5F5F5" Stroke="#33000000" StrokeThickness="1"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="EffortSliderStyle" TargetType="Slider">
		<Setter Property="Minimum" Value="0"/>
		<Setter Property="Maximum" Value="5"/>
		<Setter Property="SmallChange" Value="1"/>
		<Setter Property="LargeChange" Value="1"/>
		<Setter Property="TickFrequency" Value="1"/>
		<Setter Property="IsSnapToTickEnabled" Value="True"/>
		<Setter Property="Width" Value="175"/>
		<Setter Property="Height" Value="22"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid VerticalAlignment="Center" Height="18">
						<!-- Track background pill. Semi-transparent gray so it reads as a
						     subtle groove on both light and dark menu backgrounds. -->
						<Border CornerRadius="9" Background="#80808080"/>
						<!-- One dot per stop, under the fill/thumb: filled in by EffortSliderStops, which knows
						     how many stops the agent's slider has. -->
						<StackPanel x:Name="PART_StopDots" Orientation="Horizontal" ClipToBounds="False"/>
						<Track x:Name="PART_Track">
							<Track.DecreaseRepeatButton>
								<RepeatButton Style="{StaticResource EffortFillButtonStyle}" Command="Slider.DecreaseLarge"/>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Style="{StaticResource EffortThumbStyle}"/>
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Style="{StaticResource EffortTransparentButtonStyle}" Command="Slider.IncreaseLarge"/>
							</Track.IncreaseRepeatButton>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
